# ==============================================================================
# Web Admin Auth - Runtime Environment Configuration Example
# ==============================================================================
# Copy this file to .env and replace every blank/placeholder value before
# startup. This service is a stateless cookie adapter in front of go-auth;
# it has no database of its own.

# Address this service listens on inside the container.
LISTEN_ADDR=:8080

# Base URL of the upstream go-auth service (no trailing path).
GO_AUTH_BASE_URL=http://go-auth:5050

# Public origin of the web-admin frontend this service is deployed behind.
# Must exactly match the Origin header browsers send (scheme + host [+ port]),
# and the redirect_uris seeded for this client via seed-client
# (e.g. http://localhost or http://admin.anlew.local).
APP_ORIGIN=http://localhost

# Client credentials this service presents to go-auth as a registered
# client. AUTH_CLIENT_ID is the provider's (Google) OAuth client_id;
# AUTH_SECRET is the backend auth_secret seeded via seed-client, sent as
# X-Client-Secret and verified by go-auth against auth_secret_hash.
AUTH_CLIENT_ID=
AUTH_SECRET=

# Base64-encoded 32-byte AES-256-GCM key used to encrypt the wa_oauth
# cookie (OAuth state + PKCE verifier). Generate with:
#   openssl rand -base64 32
OAUTH_COOKIE_KEY=

# Base64-encoded 32-byte HMAC key used to sign the wa_csrf token. Generate
# with:
#   openssl rand -base64 32
CSRF_HMAC_KEY=

# Whether cookies are issued with the Secure attribute and the __Host-
# prefix. Set to false only for plain-HTTP local development.
COOKIE_SECURE=true
